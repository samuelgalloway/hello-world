# Anthropic (flaw detection)
ANTHROPIC_API_KEY=
# Optional — override the vision model used for detection (default: claude-opus-5)
CLAUDE_MODEL=

# Replicate (masked inpainting / the actual pixel fix)
REPLICATE_API_TOKEN=
# Optional — pin a specific LaMa version ("owner/model:versionhash").
# Default "allenhooo/lama" resolves to that model's latest version at runtime.
LAMA_MODEL=

# Optional — if set, the app asks for this passcode before calling any paid API.
APP_PASSCODE=
