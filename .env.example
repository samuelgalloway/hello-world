# Copy to .env.local for local development with `vercel dev`.
#
# In production, do NOT put the real value in a file at all — set it in
# Vercel → Project Settings → Environment Variables instead. Nothing that
# lives in this repo should ever contain your real key.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5
